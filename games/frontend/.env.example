# Copy to .env.local. Used server-side only by /api/analyze.
# Baseten Model APIs (preferred). Model slug: check https://inference.baseten.co/v1/models
BASETEN_API_KEY=
# BASETEN_MODEL=zai-org/GLM-5.3
# OpenAI fallback (used if Baseten fails or has no key)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# Force one provider: baseten | openai
# ANALYSIS_PROVIDER=baseten

# Therapy Game Compiler — Cloudflare TherapyGameAgent origin (server-side only).
# THERAPY_AGENT_URL=https://therapy-game-agent.<subdomain>.workers.dev
# Browser WebSocket origin for live confidence/session events. Omit to keep metrics local.
# NEXT_PUBLIC_THERAPY_AGENT_URL=https://therapy-game-agent.<subdomain>.workers.dev
# If THERAPY_AGENT_URL is unset, /api/therapy/compile uses OPENAI_API_KEY for the same tool loop.
# If no key is set, Rox still runs the local extract/conflict/validate/generate tools and shows the trace.

