# Copy to .env (or .env.local) and fill in what you need.
# Everything here is server-side only except the NEXT_PUBLIC_ entries.
# Restart the dev server after editing

BASETEN_API_KEY=
# BASETEN_MODEL=zai-org/GLM-5.3
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Cohere Rerank trims an extracted therapy note down to the sections that
# actually describe the prescription, before the compiler reads it.
# Optional: with no key the full note is passed through unchanged.
# Get one at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# COHERE_RERANK_MODEL=rerank-v3.5

# Therapy Game Compiler — Cloudflare TherapyGameAgent origin (server-side only).
# The OpenAI key stays in agent/.dev.vars. Do not put OPENAI_API_KEY here for therapy.
# THERAPY_AGENT_URL=http://127.0.0.1:5173
# Browser WebSocket origin for live confidence/session events. Omit to keep metrics local.
# NEXT_PUBLIC_THERAPY_AGENT_URL=http://127.0.0.1:5173
# In development, /api/therapy/compile defaults to http://127.0.0.1:5173.
# If the agent cannot connect, the route uses a local-safe-demo compiler with the same API contract.

# Rehab Guardian / Sentry — paste the project DSN only. Never put an auth token here.
NEXT_PUBLIC_SENTRY_DSN=
# Optional server DSN (defaults to NEXT_PUBLIC_SENTRY_DSN)
# SENTRY_DSN=
