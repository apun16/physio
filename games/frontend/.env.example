# Copy to .env.local. Used server-side only by /api/analyze.
# Baseten Model APIs (preferred). Model slug: check https://inference.baseten.co/v1/models
BASETEN_API_KEY=
# BASETEN_MODEL=zai-org/GLM-5.3
# OpenAI fallback (used if Baseten fails or has no key)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# Force one provider: baseten | openai
# ANALYSIS_PROVIDER=baseten

# Rehab Guardian / Sentry — paste the project DSN only. Never put an auth token here.
NEXT_PUBLIC_SENTRY_DSN=
# Optional server DSN (defaults to NEXT_PUBLIC_SENTRY_DSN)
# SENTRY_DSN=
# Optional source-map upload for CI builds only. Never expose this to the browser.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
